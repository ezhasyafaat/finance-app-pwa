# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance

# ── Auth ─────────────────────────────────────────────────
# Any long random string (>=16 chars). Used to sign the session JWT.
# Generate one, e.g.: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Set to 1 to close self-service registration after creating your account.
# DISABLE_REGISTRATION=1

# Set to 1 to return the password-reset token in the /api/auth/forgot response
# (self-host convenience when no email transport is configured). Leave unset in
# production — the reset link is always logged server-side regardless.
# RESET_ECHO=1

# ── AI (single OpenAI-compatible endpoint for BOTH chat + vision) ──
# Works with OpenAI, Gemini (OpenAI-compat endpoint), OpenRouter,
# Groq, LM Studio, Ollama, or any /v1/chat/completions compatible API.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
# Model used for Quick Capture (natural-language parsing)
AI_MODEL=gpt-4o-mini
# Vision-capable model used for the Receipt Scanner (OCR).
# Can be the same as AI_MODEL if it supports images.
AI_VISION_MODEL=gpt-4o-mini

# ── App ──────────────────────────────────────────────────
# Default currency label + locale for formatting
NEXT_PUBLIC_CURRENCY=IDR
NEXT_PUBLIC_LOCALE=id-ID
